rules_version = '2';

// Правила доступа к Firebase Storage проекта domio-7ad1c.
// Сюда будут грузиться фотографии к заявкам вместо локальных URI с телефона.
// Деплой: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // Фото к заявкам лежат в orders/{uid}/... — загружает только сам владелец,
    // читает любой авторизованный (мастеру нужно увидеть, что чинить)
    match /orders/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Аватары
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
