rules_version = '2';

// Правила доступа к Firebase Storage проекта domio-7ad1c.
// Деплой: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Проверенный мастер — тот же критерий, что и в firestore.rules:
    // допуск есть и отстранения нет
    function isVerifiedMaster() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/masters/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/masters/$(request.auth.uid))
             .data.get('verified', false) == true
        && firestore.get(/databases/(default)/documents/masters/$(request.auth.uid))
             .data.get('blocked', false) != true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Фото к заявке. Путь построен по её идентификатору, а не по владельцу,
    // ровно затем, чтобы правило могло спросить у Firestore, кто участник
    // этой заявки.
    //
    // Раньше здесь стояло `allow read: if request.auth != null` — то есть
    // снимок чужой квартиры открывался любому зарегистрированному по прямой
    // ссылке, и продолжал открываться даже после того, как заявка уходила
    // другому мастеру.
    // Ровно photo.jpg, а не {allPaths=**}: под заявкой теперь живёт и
    // переписка (chat/), у которой читатели другие. Общий шаблон отдавал бы
    // фото из чата всем проверенным мастерам, пока заявка в поиске, — а при
    // пересечении шаблонов Storage складывает разрешения, сузить нельзя.
    match /orders/{orderId}/photo.jpg {

      function order() {
        return firestore.get(/databases/(default)/documents/orders/$(orderId)).data;
      }

      allow read: if request.auth != null && (
        order().clientId == request.auth.uid
        || order().get('masterId', null) == request.auth.uid
        // Свободную заявку смотрят мастера, которые могут за неё взяться:
        // не увидев поломку, цену не назовёшь
        || (order().status == 'Поиск мастера' && isVerifiedMaster())
      );

      // Снимок пишется, пока заявку никто не взял — тот же замок, что у
      // ссылки в самой заявке: подменить фото у мастера в работе нельзя
      allow write: if request.auth != null
        && order().clientId == request.auth.uid
        && order().status == 'Поиск мастера'
        && request.resource.size < 10 * 1024 * 1024
        && isImage();

      allow delete: if request.auth != null && order().clientId == request.auth.uid;
    }

    // Фото в переписке заявки. Читают только стороны сделки и модератор
    // (он разбирает споры по диалогу — фото часть диалога); пишут обе
    // стороны. Файлы лежат под orders/{orderId}/, чтобы удаление аккаунта
    // стирало их вместе с остальным одним префиксом. Удалять нельзя никому:
    // отправленное сообщение не редактируется, и его фото тоже.
    match /orders/{orderId}/chat/{fileName} {

      function order() {
        return firestore.get(/databases/(default)/documents/orders/$(orderId)).data;
      }

      function isParty() {
        return request.auth != null && (
          order().clientId == request.auth.uid
          || order().get('masterId', null) == request.auth.uid
        );
      }

      allow read: if isParty() || isAdmin();

      // Пока сделка жива — как и сами сообщения в firestore.rules. Только
      // create: отправленное фото, как и сообщение, не переписывается —
      // иначе снимок в чужой переписке можно было бы подменить задним числом
      allow create: if isParty()
        && order().status in ['В работе', 'Ждёт подтверждения', 'Завершена']
        && request.resource.size < 10 * 1024 * 1024
        && isImage();
    }

    // Фотография лица для проверки мастера. В отличие от фото заявки это
    // документ, удостоверяющий личность: видят его только сам мастер и
    // модератор, никакой «любой авторизованный» здесь недопустим.
    // Ровно один файл, face.jpg: под свободным именем любой аккаунт складывал
    // бы сюда что угодно до восьми мегабайт за файл без счёта
    match /verification/{uid}/face.jpg {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && isImage();
      // Снимок удаляется вместе с аккаунтом
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
