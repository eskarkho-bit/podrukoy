# Ключ SMS.RU для входа по номеру телефона (личный кабинет → api_id).
# Скопируйте в functions/.env и подставьте свой — .env в git не попадает.
# Пока ключа нет, requestPhoneCode отвечает «не настроено», и приложение
# показывает вход по телефону недоступным — по почте всё работает.
#
# Для боевой эксплуатации ключ лучше держать в Secret Manager: переменные
# окружения функции видны всем, у кого есть доступ к проекту Firebase.
SMSRU_API_ID=

# Канал доставки кода. По умолчанию — звонок: робот звонит на номер, код —
# последние четыре цифры звонящего номера; работает на любом аккаунте SMS.RU.
# СМС требуют буквенного отправителя, которого оформляют только юрлицам и ИП
# по договору, — когда он появится, раскомментируйте:
# SMSRU_CHANNEL=sms
