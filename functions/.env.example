# Настройки функций, которые не являются секретами. Скопируйте в
# functions/.env — файл в git не попадает.
#
# Ключа SMS.RU (личный кабинет → api_id) здесь нет намеренно: переменные
# окружения функции видны всем, у кого есть доступ к проекту Firebase. Ключ
# живёт в Secret Manager и задаётся один раз:
#   firebase functions:secrets:set SMSRU_API_ID
# Пока секрета нет, requestPhoneCode отвечает «не настроено», и приложение
# показывает вход по телефону недоступным — по почте всё работает.

# Канал доставки кода. По умолчанию — звонок: робот звонит на номер, код —
# последние четыре цифры звонящего номера; работает на любом аккаунте SMS.RU.
# СМС требуют буквенного отправителя, которого оформляют только юрлицам и ИП
# по договору, — когда он появится, раскомментируйте:
# SMSRU_CHANNEL=sms
