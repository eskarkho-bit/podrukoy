# Ключи магазина ЮKassa. Скопируйте в functions/.env и подставьте свои —
# .env в git не попадает.
#
# Взять их можно в личном кабинете ЮKassa: Настройки → Магазин.
# Пока переменных нет, привязка карты честно отвечает «не настроено»,
# и заявку мастера отправить нельзя — карта обязательна.
#
# Для боевой эксплуатации ключ лучше держать в Secret Manager: переменные
# окружения функции видны всем, у кого есть доступ к проекту Firebase.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
