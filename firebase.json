{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "hosting": {
    "public": "legal-site",
    "predeploy": ["node scripts/legal-site.mjs"],
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "/api/requestPhoneCode",
        "function": {
          "functionId": "requestPhoneCode",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/verifyPhoneCode",
        "function": {
          "functionId": "verifyPhoneCode",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/adminCloseOrder",
        "function": {
          "functionId": "adminCloseOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/adminSetUserBlocked",
        "function": {
          "functionId": "adminSetUserBlocked",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/adminSetMasterBlocked",
        "function": {
          "functionId": "adminSetMasterBlocked",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/adminSetReviewHidden",
        "function": {
          "functionId": "adminSetReviewHidden",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/adminResolveComplaint",
        "function": {
          "functionId": "adminResolveComplaint",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/adminFindUserByPhone",
        "function": {
          "functionId": "adminFindUserByPhone",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    }
  }
}
